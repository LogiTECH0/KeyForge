<Window x:Class="KeyForge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KeyForge"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="CanMinimize"
        BorderThickness="1"
        Height="620"
        Width="920"
        MinHeight="500"
        MinWidth="760"
        WindowStartupLocation="CenterScreen"
        Foreground="#EEEEF2"
        FontFamily="./Assets/#Asap Sharp"
        Icon="/KeyForge.App;component/Assets/icon.png">

        <Window.Resources>
                <!-- Color palette -->
                <SolidColorBrush x:Key="BackgroundBrush"
                                 Color="#101014"/>
                <SolidColorBrush x:Key="SidebarBrush"
                                 Color="#15151B"/>
                <SolidColorBrush x:Key="PanelBrush"
                                 Color="#19191F"/>
                <SolidColorBrush x:Key="SurfaceBrush"
                                 Color="#25252B"/>
                <SolidColorBrush x:Key="BorderBrush"
                                 Color="#34343D"/>
                <SolidColorBrush x:Key="MutedBrush"
                                 Color="#92929D"/>
                <SolidColorBrush x:Key="AccentBrush"
                                 Color="#AB61ED"/>
                <SolidColorBrush x:Key="AccentHoverBrush"
                                 Color="#BD83F5"/>
                <SolidColorBrush x:Key="TextBrush"
                                 Color="#EEEEF2"/>

                <!-- Primary button -->
                <Style x:Key="ActionButton"
                       TargetType="Button">
                        <Setter Property="Foreground"
                                Value="#FFFFFF"/>
                        <Setter Property="Background"
                                Value="#AB61ED"/>
                        <Setter Property="BorderThickness"
                                Value="0"/>
                        <Setter Property="Padding"
                                Value="16,10"/>
                        <Setter Property="FontSize"
                                Value="13"/>
                        <Setter Property="FontWeight"
                                Value="SemiBold"/>
                        <Setter Property="Cursor"
                                Value="Hand"/>
                        <Setter Property="Template">
                                <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                                <Border x:Name="ButtonBorder"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="8"
                                                        Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver"
                                                                 Value="True">
                                                                <Setter TargetName="ButtonBorder"
                                                                        Property="Background"
                                                                        Value="#BD83F5"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed"
                                                                 Value="True">
                                                                <Setter TargetName="ButtonBorder"
                                                                        Property="Opacity"
                                                                        Value="0.75"/>
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled"
                                                                 Value="False">
                                                                <Setter TargetName="ButtonBorder"
                                                                        Property="Opacity"
                                                                        Value="0.4"/>
                                                        </Trigger>
                                                </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                </Setter.Value>
                        </Setter>
                </Style>
                <Style x:Key="TitleBarButton"
                       TargetType="Button">
                        <Setter Property="Width"
                                Value="46"/>
                        <Setter Property="Height"
                                Value="36"/>
                        <Setter Property="Background"
                                Value="Transparent"/>
                        <Setter Property="Foreground"
                                Value="#EEEEF2"/>
                        <Setter Property="BorderThickness"
                                Value="0"/>
                        <Setter Property="FontFamily"
                                Value="Segoe UI"/>
                        <Setter Property="FontSize"
                                Value="14"/>
                        <Setter Property="Cursor"
                                Value="Hand"/>
                        <Setter Property="FocusVisualStyle"
                                Value="{x:Null}"/>
                        <Setter Property="Template">
                                <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                                <Border x:Name="ButtonBackground"
                                                        Background="{TemplateBinding Background}">
                                                        <ContentPresenter
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"/>
                                                </Border>

                                                <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver"
                                                                 Value="True">
                                                                <Setter TargetName="ButtonBackground"
                                                                        Property="Background"
                                                                        Value="#29252F"/>
                                                        </Trigger>

                                                        <Trigger Property="IsPressed"
                                                                 Value="True">
                                                                <Setter TargetName="ButtonBackground"
                                                                        Property="Background"
                                                                        Value="#382448"/>
                                                        </Trigger>
                                                </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                </Setter.Value>
                        </Setter>
                </Style>
                <Style x:Key="TrafficLightButton"
                       TargetType="Button">
                        <Setter Property="Width"
                                Value="12"/>
                        <Setter Property="Height"
                                Value="12"/>
                        <Setter Property="Margin"
                                Value="0,0,8,0"/>
                        <Setter Property="Padding"
                                Value="0"/>
                        <Setter Property="BorderThickness"
                                Value="0"/>
                        <Setter Property="Background"
                                Value="#777777"/>
                        <Setter Property="Cursor"
                                Value="Hand"/>
                        <Setter Property="FocusVisualStyle"
                                Value="{x:Null}"/>

                        <Setter Property="Template">
                                <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                                <Ellipse x:Name="Circle"
                                                         Fill="{TemplateBinding Background}"/>

                                                <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver"
                                                                 Value="True">
                                                                <Setter TargetName="Circle"
                                                                        Property="Opacity"
                                                                        Value="0.75"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed"
                                                                 Value="True">
                                                                <Setter TargetName="Circle"
                                                                        Property="Opacity"
                                                                        Value="0.5"/>
                                                        </Trigger>
                                                </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                </Setter.Value>
                        </Setter>
                </Style>

                <Style x:Key="CloseButton"
                       TargetType="Button"
                       BasedOn="{StaticResource TitleBarButton}">
                        <Style.Triggers>
                                <Trigger Property="IsMouseOver"
                                         Value="True">
                                        <Setter Property="Background"
                                                Value="#D9435F"/>
                                        <Setter Property="Foreground"
                                                Value="White"/>
                                </Trigger>
                        </Style.Triggers>
                </Style>

                <!-- Secondary button -->
                <Style x:Key="SecondaryButton"
                       TargetType="Button"
                       BasedOn="{StaticResource ActionButton}">
                        <Setter Property="Background"
                                Value="#292930"/>
                </Style>

                <!-- Keybind table -->
                <Style TargetType="DataGrid">
                        <Setter Property="Background"
                                Value="#19191F"/>
                        <Setter Property="Foreground"
                                Value="#EEEEF2"/>
                        <Setter Property="BorderThickness"
                                Value="0"/>
                        <Setter Property="RowBackground"
                                Value="#19191F"/>
                        <Setter Property="AlternatingRowBackground"
                                Value="#202027"/>
                        <Setter Property="GridLinesVisibility"
                                Value="All"/>
                        <Setter Property="HorizontalGridLinesBrush"
                                Value="#34343D"/>
                        <Setter Property="VerticalGridLinesBrush"
                                Value="#34343D"/>
                        <Setter Property="HeadersVisibility"
                                Value="Column"/>
                        <Setter Property="CanUserAddRows"
                                Value="False"/>
                        <Setter Property="CanUserResizeRows"
                                Value="False"/>
                        <Setter Property="SelectionUnit"
                                Value="FullRow"/>
                        <Setter Property="SelectionMode"
                                Value="Single"/>
                        <Setter Property="RowHeight"
                                Value="48"/>
                        <Setter Property="ColumnHeaderHeight"
                                Value="42"/>
                        <Setter Property="FontSize"
                                Value="13"/>
                        <Setter Property="BorderBrush"
                                Value="#34343D"/>
                        <Setter Property="AlternationCount"
                                Value="2"/>
                        <Setter Property="FocusVisualStyle"
                                Value="{x:Null}"/>
                </Style>

                <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background"
                                Value="#25252B"/>
                        <Setter Property="Foreground"
                                Value="#92929D"/>
                        <Setter Property="FontWeight"
                                Value="SemiBold"/>
                        <Setter Property="Padding"
                                Value="16,0"/>
                        <Setter Property="BorderThickness"
                                Value="0"/>
                        <Setter Property="BorderBrush"
                                Value="#34343D"/>
                        <Setter Property="BorderThickness"
                                Value="0,0,1,1"/>
                        <Setter Property="HorizontalContentAlignment"
                                Value="Center"/>
                        <Setter Property="FontSize"
                                Value="12"/>
                </Style>

                <Style TargetType="DataGridCell">
                        <Setter Property="Padding"
                                Value="16,0"/>
                        <Setter Property="BorderThickness"
                                Value="0,0,1,0"/>
                        <Setter Property="BorderBrush"
                                Value="#34343D"/>
                        <Setter Property="VerticalContentAlignment"
                                Value="Center"/>
                        <Setter Property="FocusVisualStyle"
                                Value="{x:Null}"/>
                        <Setter Property="FontSize"
                                Value="15"/>
                        <Setter Property="TextBlock.TextAlignment"
                                Value="Center"/>
                        <Setter Property="HorizontalContentAlignment"
                                Value="Center"/>

                        <Style.Triggers>
                                <Trigger Property="IsSelected"
                                         Value="True">
                                        <Setter Property="Background"
                                                Value="#382448"/>
                                        <Setter Property="Foreground"
                                                Value="#FFFFFF"/>
                                </Trigger>
                        </Style.Triggers>
                </Style>
        </Window.Resources>
        <Border Background="#101014"
                CornerRadius="12"
                BorderBrush="#34343D"
                BorderThickness="1"
                ClipToBounds="True">
                <Grid>
                        <Grid.RowDefinitions>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0"
                                Background="#15151B"
                                BorderBrush="#34343D"
                                CornerRadius="12,12,0,0"
                                ClipToBounds="True"
                                BorderThickness="0,0,0,1"
                                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">

                                <Grid>
                                        <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center"
                                                    Margin="14,0,0,0">

                                                <Button Style="{StaticResource TrafficLightButton}"
                                                        Background="#FF5F57"
                                                        Click="Close_Click"
                                                        ToolTip="Close"/>

                                                <Button Style="{StaticResource TrafficLightButton}"
                                                        Background="#FEBC2E"
                                                        Click="Minimize_Click"
                                                        ToolTip="Minimize"/>

                                                <Button Style="{StaticResource TrafficLightButton}"
                                                        Background="#28C840"
                                                        IsEnabled="False"
                                                        ToolTip="Disabled"/>

                                                <Border Width="1"
                                                        Height="18"
                                                        Background="#34343D"
                                                        Margin="5,0,12,0"/>


                                                <TextBlock Text="KeyForge"
                                                           Foreground="#EEEEF2"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"/>
                                        </StackPanel>
                                </Grid>
                        </Border>
                        <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Sidebar -->
                                <Border Grid.Column="0"
                                        Background="#15151B"
                                        BorderBrush="#34343D"
                                        CornerRadius="0,0,0,12"
                                        ClipToBounds="True"
                                        BorderThickness="0,0,1,0">

                                        <DockPanel Margin="22">

                                                <!-- Sidebar footer -->
                                                <StackPanel DockPanel.Dock="Bottom"
                                                            Margin="0,20,0,0">
                                                        <Border Height="1"
                                                                Background="#34343D"
                                                                Margin="0,0,0,16"/>

                                                        <TextBlock Text="KEYFORGE"
                                                                   Foreground="#92929D"
                                                                   FontSize="10"
                                                                   FontWeight="Bold"/>

                                                        <TextBlock Text="Custom hotkeys"
                                                                   Foreground="#777783"
                                                                   FontSize="11"
                                                                   Margin="0,5,0,0"/>
                                                </StackPanel>

                                                <StackPanel>
                                                        <!-- App logo -->
                                                        <StackPanel Orientation="Horizontal"
                                                                    Margin="0,4,0,34">

                                                                <Border Width="38"
                                                                        Height="38"
                                                                        Background="#AB61ED">
                                                                        <Image Source="Assets/icon.png"
                                                                               Width="35"
                                                                               Height="35"
                                                                               Stretch="Uniform"/>
                                                                </Border>

                                                                <StackPanel VerticalAlignment="Center"
                                                                            Margin="12,0,0,0">
                                                                        <TextBlock Text="KeyForge"
                                                                                   FontSize="19"
                                                                                   FontWeight="Bold"/>

                                                                        <TextBlock Text="DESKTOP"
                                                                                   FontSize="9"
                                                                                   Foreground="#AB61ED"
                                                                                   FontWeight="Bold"
                                                                                   Margin="1,2,0,0"/>
                                                                </StackPanel>
                                                        </StackPanel>

                                                        <TextBlock Text="WORKSPACE"
                                                                   FontSize="10"
                                                                   FontWeight="Bold"
                                                                   Foreground="#777783"
                                                                   Margin="0,0,0,12"/>

                                                        <!-- Active navigation item -->
                                                        <Border Background="#30213D"
                                                                CornerRadius="8"
                                                                Padding="12,13">
                                                                <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="⌘"
                                                                                   Foreground="#AB61ED"
                                                                                   FontSize="18"
                                                                                   Margin="0,0,12,0"/>

                                                                        <TextBlock Text="Keybinds"
                                                                                   FontWeight="SemiBold"
                                                                                   VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                        </Border>

                                                        <TextBlock Text="Configure your shortcuts"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="#92929D"
                                                                   FontSize="12"
                                                                   Margin="12,10,0,0"/>
                                                </StackPanel>
                                        </DockPanel>
                                </Border>

                                <!-- Main content -->
                                <Grid Grid.Column="1"
                                      Margin="32,28,32,24">

                                        <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Page header -->
                                        <StackPanel Grid.Row="0"
                                                    Margin="0,0,0,26">

                                                <TextBlock Text="Keybinds"
                                                           FontSize="28"
                                                           FontWeight="Bold"/>

                                                <TextBlock Text="Manage your keyboard shortcuts and actions."
                                                           Foreground="#92929D"
                                                           FontSize="13"
                                                           Margin="0,7,0,0"/>
                                        </StackPanel>

                                        <!-- Toolbar -->
                                        <Grid Grid.Row="1"
                                              Margin="0,0,0,16">

                                                <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="YOUR SHORTCUTS"
                                                                   FontSize="10"
                                                                   FontWeight="Bold"
                                                                   Foreground="#92929D"/>

                                                        <TextBlock Text="Configure actions"
                                                                   FontSize="12"
                                                                   Foreground="#777783"
                                                                   Margin="0,4,0,0"/>
                                                </StackPanel>

                                                <Button Grid.Column="1"
                                                        Content="+ Add keybind"
                                                        Style="{StaticResource ActionButton}"
                                                        Click="AddKeybind_Click"/>
                                        </Grid>

                                        <!-- Keybinds table -->
                                        <Border Grid.Row="2"
                                                Background="#19191F"
                                                BorderBrush="#34343D"
                                                BorderThickness="1"
                                                CornerRadius="0"
                                                ClipToBounds="True">

                                                <DataGrid x:Name="KeybindsGrid"
                                                          AutoGenerateColumns="False"
                                                          IsReadOnly="True"
                                                          AlternationCount="2"
                                                          VerticalAlignment="Top"
                                                          MaxHeight="400">
                                                        <DataGrid.Columns>
                                                                <DataGridTextColumn Header="KEYBIND"
                                                                                    Binding="{Binding Keys}"
                                                                                    Width="*"/>

                                                                <DataGridTextColumn Header="FUNCTION"
                                                                                    Binding="{Binding Action}"
                                                                                    Width="*"/>
                                                        </DataGrid.Columns>
                                                </DataGrid>
                                        </Border>

                                        <!-- Footer actions -->
                                        <Grid Grid.Row="3"
                                              Margin="0,18,0,0">

                                                <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Orientation="Horizontal"
                                                            VerticalAlignment="Center">

                                                        <Ellipse Width="7"
                                                                 Height="7"
                                                                 Fill="#AB61ED"
                                                                 Margin="0,0,8,0"/>

                                                        <TextBlock Text="Changes are managed locally"
                                                                   Foreground="#92929D"
                                                                   FontSize="11"
                                                                   VerticalAlignment="Center"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1"
                                                            Orientation="Horizontal">

                                                        <Button Content="Edit"
                                                                Style="{StaticResource SecondaryButton}"
                                                                Margin="0,0,8,0"
                                                                Click="EditKeybind_Click"/>

                                                        <Button Content="Delete"
                                                                Style="{StaticResource SecondaryButton}"
                                                                Click="DeleteKeybind_Click"/>
                                                </StackPanel>
                                        </Grid>
                                </Grid>
                        </Grid>
                </Grid>
        </Border>
</Window>
